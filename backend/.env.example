APP_NAME=Smart Carbon Credit Analytics Platform
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:////var/data/backend.db
ALLOWED_ORIGINS=https://smart-carbon-analytics.onrender.com
REPORTS_DIR=/var/data/reports
UPLOADS_DIR=/var/data/uploads
LOGS_DIR=/var/data/logs
MODEL_PATH=/app/backend/app/ai/best_bilstm.keras
SCALER_PATH=/app/backend/app/ai/scaler.pkl
RATE_LIMIT=100/minute

# Ollama: leave OLLAMA_API_KEY empty for local Ollama. In Render, set
# OLLAMA_API_KEY as a secret and set OLLAMA_MODEL=gpt-oss:20b.
OLLAMA_API_KEY=
# OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
